#!/system/bin/sh
# agy-sys -- Root power-user helper for Antigravity (KernelSU/bakaSU/Magisk/APatch).
# Wraps common system diagnostics, Doze/OOM anti-kill protection, module listing,
# APK installation, logcat, and /storage/emulated/0/Android/data access via agy-root.

set -u

BASEDIR="$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)"
AGY_ROOT="$BASEDIR/agy-root"
[ ! -x "$AGY_ROOT" ] && [ -n "${PREFIX:-}" ] && AGY_ROOT="$PREFIX/bin/agy-root"
PKG="${AGY_APPLICATION_ID:-com.agy}"

sh_quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

show_help() {
  cat <<'EOF'
Usage: agy-sys <subcommand> [args...]

Subcommands:
  info                    Show Android, kernel, root manager, RAM, Doze & OOM status
  protect                 Whitelist Antigravity from Doze & protect PIDs from LMKD (oom_score_adj=-100)
  backup [--full] [file]  Archive $HOME/.gemini chats & settings (.zip) to Download/Antigravity-Backups/
  restore <file|latest>   Restore a .zip backup into $HOME/.gemini (compatible with in-app Restore)
  modules                 List installed KernelSU / bakaSU / Magisk modules (/data/adb/modules)
  install <path.apk>      Silently install/upgrade an APK via pm install -r
  logcat [lines]          Show recent Android logcat filtered for Antigravity / crashes (default: 120)
  android-data [subpath]  List /storage/emulated/0/Android/data[/subpath] using global mount namespace (-mm)
  help                    Show this help message
EOF
}

cmd_backup() {
  FULL=0
  OUT=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --full) FULL=1; shift ;;
      *) OUT="$1"; shift ;;
    esac
  done
  H="${HOME:-/data/user/0/$PKG/files}"
  if [ ! -d "$H/.gemini" ]; then
    echo "agy-sys: no .gemini directory found at $H/.gemini" >&2
    exit 1
  fi
  BDIR="/storage/emulated/0/Download/Antigravity-Backups"
  mkdir -p "$BDIR" 2>/dev/null || true
  if [ -z "$OUT" ]; then
    OUT="$BDIR/agy-backup-$(date +%Y%m%d-%H%M%S).zip"
  fi
  PY="${PREFIX:-$H/usr}/bin/python3"
  [ ! -x "$PY" ] && PY="python3"
  LD_LIBRARY_PATH="${PREFIX:-$H/usr}/lib" "$PY" - "$H" "$OUT" "$FULL" <<'PYEOF'
import os, sys, zipfile
home, out_zip, full = sys.argv[1], sys.argv[2], sys.argv[3] == "1"
skip = {".gemini/antigravity-app/builtin", ".gemini/antigravity-app/crashes"}
if not full:
    skip.add(".gemini/antigravity-app/scratch")
count = 0
with zipfile.ZipFile(out_zip, "w", compression=zipfile.ZIP_DEFLATED) as zf:
    for root, dirs, files in os.walk(os.path.join(home, ".gemini")):
        rel_root = os.path.relpath(root, home).replace("\\", "/")
        dirs[:] = [d for d in dirs if f"{rel_root}/{d}" not in skip]
        if rel_root in skip:
            continue
        for f in files:
            abs_p = os.path.join(root, f)
            rel_p = os.path.relpath(abs_p, home).replace("\\", "/")
            if os.path.isfile(abs_p):
                zf.write(abs_p, rel_p)
                count += 1
size_kb = max(1, os.path.getsize(out_zip) // 1024)
print(f"[OK] Backed up {count} files ({size_kb} KB) -> {out_zip}")
PYEOF
}

cmd_restore() {
  if [ $# -lt 1 ]; then
    echo "Usage: agy-sys restore <backup.zip|latest>" >&2
    exit 2
  fi
  SRC="$1"
  BDIR="/storage/emulated/0/Download/Antigravity-Backups"
  if [ "$SRC" = "latest" ]; then
    SRC="$(ls -t "$BDIR"/*.zip 2>/dev/null | head -n 1 || true)"
    if [ -z "$SRC" ]; then
      echo "agy-sys: no .zip backups found in $BDIR" >&2
      exit 1
    fi
  fi
  if [ ! -f "$SRC" ]; then
    echo "agy-sys: backup file not found: $SRC" >&2
    exit 1
  fi
  H="${HOME:-/data/user/0/$PKG/files}"
  PY="${PREFIX:-$H/usr}/bin/python3"
  [ ! -x "$PY" ] && PY="python3"
  LD_LIBRARY_PATH="${PREFIX:-$H/usr}/lib" "$PY" - "$H" "$SRC" <<'PYEOF'
import os, sys, zipfile
home, src_zip = os.path.realpath(sys.argv[1]), sys.argv[2]
gemini_root = os.path.realpath(os.path.join(home, ".gemini"))
os.makedirs(gemini_root, exist_ok=True)
count = 0
with zipfile.ZipFile(src_zip, "r") as zf:
    for info in zf.infolist():
        if not info.filename.startswith(".gemini/") or info.is_dir():
            continue
        dest = os.path.realpath(os.path.join(home, info.filename))
        if not (dest == gemini_root or dest.startswith(gemini_root + os.sep)):
            raise RuntimeError(f"Refusing unsafe path: {info.filename}")
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        with zf.open(info, "r") as src_f, open(dest, "wb") as dst_f:
            dst_f.write(src_f.read())
        count += 1
print(f"[OK] Restored {count} files from {src_zip} into {gemini_root}")
print("Please restart Antigravity to load restored chats and settings.")
PYEOF
}

cmd_info() {
  echo "=== Antigravity System Info ==="
  echo "Package:  $PKG"
  echo "Android:  $(/system/bin/getprop ro.build.version.release 2>/dev/null || echo unknown) (API $(/system/bin/getprop ro.build.version.sdk 2>/dev/null || echo ?))"
  echo "Device:   $(/system/bin/getprop ro.product.manufacturer 2>/dev/null || true) $(/system/bin/getprop ro.product.model 2>/dev/null || true)"
  echo "Kernel:   $(uname -r 2>/dev/null || echo unknown)"
  _se="$(/system/bin/getenforce 2>/dev/null || true)"
  [ -z "$_se" ] && _se="$("$AGY_ROOT" -c '/system/bin/getenforce' 2>/dev/null || true)"
  echo "SELinux:  ${_se:-unknown}"
  echo ""
  echo "=== Root Status ==="
  "$AGY_ROOT" status || true
  echo ""
  echo "=== Memory ==="
  grep -E '^(MemTotal|MemAvailable|SwapTotal|SwapFree):' /proc/meminfo 2>/dev/null || true
  echo ""
  echo "=== Process OOM & Doze ==="
  "$AGY_ROOT" -c "
    echo -n 'Doze whitelisted: '
    if /system/bin/dumpsys deviceidle whitelist 2>/dev/null | grep -q $(sh_quote "$PKG"); then
      echo 'yes'
    else
      echo 'no (run: agy-sys protect)'
    fi
    for d in /proc/[0-9]*; do
      cl=\"\$(tr '\\0' ' ' < \"\$d/cmdline\" 2>/dev/null || true)\"
      case \"\$cl\" in *$(sh_quote "$PKG")*|*language_server*|*agy-daemon*)
        p=\"\${d#/proc/}\"
        adj=\"\$(cat \"\$d/oom_score_adj\" 2>/dev/null || echo '?')\"
        echo \"  PID \$p (oom_score_adj=\$adj): \$(printf '%.70s' \"\$cl\")\"
      ;; esac
    done
  " 2>/dev/null || echo "  (grant root for Doze/OOM inspection)"
}

cmd_protect() {
  "$AGY_ROOT" -c "
    PKG=$(sh_quote "$PKG")
    if /system/bin/cmd deviceidle whitelist +\"\$PKG\" >/dev/null 2>&1 || /system/bin/dumpsys deviceidle whitelist +\"\$PKG\" >/dev/null 2>&1; then
      echo \"[OK] Added \$PKG to Android Doze whitelist\"
    else
      echo \"[WARN] Could not update Doze whitelist\"
    fi
    COUNT=0
    for d in /proc/[0-9]*; do
      cl=\"\$(tr '\\0' ' ' < \"\$d/cmdline\" 2>/dev/null || true)\"
      case \"\$cl\" in *\"\$PKG\"*|*language_server*|*libloader*|*agy-daemon*)
        p=\"\${d#/proc/}\"
        if echo -100 > \"\$d/oom_score_adj\" 2>/dev/null; then
          echo \"[OK] Protected PID \$p (oom_score_adj=-100)\"
          COUNT=\$((COUNT+1))
        fi
      ;; esac
    done
    echo \"Done. Protected \$COUNT process(es).\"
  "
}

cmd_modules() {
  "$AGY_ROOT" -mm -c '
    MODS="/data/adb/modules"
    if [ ! -d "$MODS" ]; then
      echo "No module directory found at $MODS"
      exit 0
    fi
    found=0
    for m in "$MODS"/*; do
      [ -d "$m" ] || continue
      found=1
      id="$(basename "$m")"
      name="$(grep -m1 "^name=" "$m/module.prop" 2>/dev/null | cut -d= -f2-)"
      ver="$(grep -m1 "^version=" "$m/module.prop" 2>/dev/null | cut -d= -f2-)"
      state="enabled"
      [ -f "$m/disable" ] && state="disabled"
      [ -f "$m/remove" ] && state="pending-remove"
      printf "  %-24s %-16s [%s] %s\n" "$id" "${ver:-?}" "$state" "${name:-}"
    done
    [ "$found" = "0" ] && echo "No modules installed in $MODS"
  '
}

cmd_install() {
  if [ $# -lt 1 ]; then
    echo "Usage: agy-sys install <path.apk>" >&2
    exit 2
  fi
  APK="$1"
  if [ ! -f "$APK" ]; then
    echo "agy-sys: file not found: $APK" >&2
    exit 1
  fi
  "$AGY_ROOT" --fallback-rish -mm -c "/system/bin/pm install -r $(sh_quote "$APK")"
}

cmd_logcat() {
  LINES="${1:-120}"
  "$AGY_ROOT" --fallback-rish -c "/system/bin/logcat -d -t $(sh_quote "$LINES") | grep -iE 'agy|MainActivity|CoreServer|RootBridge|AndroidRuntime|FATAL|LMKD' || true"
}

cmd_android_data() {
  SUB="${1:-}"
  TARGET="/storage/emulated/0/Android/data"
  [ -n "$SUB" ] && TARGET="$TARGET/$SUB"
  "$AGY_ROOT" --fallback-rish -mm -c "ls -la $(sh_quote "$TARGET")"
}

if [ $# -eq 0 ]; then
  show_help
  exit 0
fi

SUBCMD="$1"
shift

case "$SUBCMD" in
  info)         cmd_info "$@" ;;
  protect)      cmd_protect "$@" ;;
  backup)       cmd_backup "$@" ;;
  restore)      cmd_restore "$@" ;;
  modules)      cmd_modules "$@" ;;
  install)      cmd_install "$@" ;;
  logcat)       cmd_logcat "$@" ;;
  android-data) cmd_android_data "$@" ;;
  -h|--help|help) show_help ;;
  *)
    echo "agy-sys: unknown subcommand '$SUBCMD'" >&2
    show_help >&2
    exit 2
    ;;
esac
